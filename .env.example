# Copy to .env and set the stack values. Restart a service after changes.

EDGE_HOME=/opt/voip-edge
EDGE_RUN=/run/kamailio-edge

# Images: leave unset to build locally, or set a GHCR tag.
#CONSOLE_IMAGE=ghcr.io/<owner>/voip-edge-console:0.1.11
#RTPENGINE_IMAGE=ghcr.io/<owner>/voip-edge-rtpengine:latest
#RTPE_VERSION=mr26.3.1.2

# Kamailio memory, MB.
#SHM_MEMORY=256
#PKG_MEMORY=64

# Console. Set token and secret; blank becomes random per process.
CONSOLE_TOKEN=
CONSOLE_SECRET=
CONSOLE_UID=10001
CONSOLE_GID=10001
CONSOLE_BIND=100.64.0.9
CONSOLE_PORT=8080
CONSOLE_SECURE_COOKIE=1
CONSOLE_SESSION_TTL=43200
CONSOLE_LOGIN_RATE=5
CONSOLE_RPC_TIMEOUT_MS=2000
# Set only when the console is not host-networked: the RPC reply socket is
# created in a directory shared with Kamailio (the run volume).
#CONSOLE_RPC_REPLY_DIR=/run/kamailio
# Comma-separated allowed tenant suffixes. Also the wizard base-domain list.
CONSOLE_ALLOWED_SUFFIXES=home.example.net
CONSOLE_POLL_MS=15000
CONSOLE_READONLY=1
CONSOLE_TLS_LIVE=1
CONSOLE_SWEEPER_INTERVAL=30
CONSOLE_ENFORCE_CAPABILITIES=1

# OIDC: both = SSO + token, oidc = SSO only, token = token only.
CONSOLE_AUTH_MODE=both
#OIDC_ISSUER=https://id.example.net
#OIDC_CLIENT_ID=voip-edge-console
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email groups
#OIDC_REDIRECT_URI=https://console.example.net/auth/callback
#OIDC_POST_LOGOUT_URI=https://console.example.net/login
#OIDC_ALLOWED_GROUPS=edge-operators
#OIDC_ALLOWED_EMAIL_DOMAINS=example.net
#OIDC_PROVIDER_NAME=Example ID
#OIDC_ALLOW_ANY=1
#OIDC_INSECURE=1

# ACME/TLS. ACME_CERT_NAME must be the first ACME_DOMAINS entry.
ACME_EMAIL=admin@example.net
ACME_DOMAINS=sip.alpha.home.example.net,*.home.example.net
ACME_CERT_NAME=sip.alpha.home.example.net
#ACME_SERVER=letsencrypt
#ACME_KEYLENGTH=2048
#ACME_DNSSLEEP=60
#ACME_DNS_PROVIDER=dns_nsupdate
#ACME_FORCE_ISSUE=0

# RFC2136/nsupdate. TSIG key: ${EDGE_HOME}/acme/technitium_tsig.
NSUPDATE_SERVER=192.0.2.53
#NSUPDATE_SERVER_PORT=53
#NSUPDATE_ZONE=home.example.net
#NSUPDATE_KEY=/run/secrets/technitium_tsig
#NSUPDATE_OPT=
# dns_technitium only:
#Technitium_Server=
#Technitium_Token=

# Optional Homer profile. Set a password before enabling.
#HOMER_DB_PASS=change-me
#HOMER_RETENTION_DAYS=7
