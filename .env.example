# .env.example — VoIP Edge Console (plan §10)
#
# Copy to .env next to compose.yml, or paste the values into the Arcane stack
# environment editor. Restart the console after changing anything: settings are
# read once at import.
#
# The console is a SECOND FACTOR behind Pangolin SSO, not a replacement for it.
# Never publish ${CONSOLE_BIND}:${CONSOLE_PORT} directly to the Internet.

# --- shared edge-stack paths ------------------------------------------------
# Same values as the voip-edge stack env (kamailio-edge/docker/.env.example).
# The console mounts ${EDGE_HOME}/kamailio/db and ${EDGE_HOME}/console.
EDGE_HOME=/opt/voip-edge
EDGE_RUN=/run/kamailio-edge

# --- container image ------------------------------------------------------
# Pull a published GHCR image instead of using the local compose build default:
# CONSOLE_IMAGE=ghcr.io/<owner>/voip-edge-console:0.1.11

# --- container identity (build args and runtime group) ---------------------
# The image bakes this UID/GID. The runtime default is root (see compose.yml)
# because the stock Kamailio DB/WAL files are root-owned; these values matter
# only if you switch to the non-root recipe in docs/ops/deploy.md.
CONSOLE_UID=10001
CONSOLE_GID=10001

# --- authentication / session ----------------------------------------------
# Generate both values, e.g.: openssl rand -hex 32
# There is deliberately no usable default in production: when either value is
# unset or blank the process generates a random one.  A random CONSOLE_TOKEN
# means nobody can sign in, and a random CONSOLE_SECRET invalidates all
# sessions on restart, so SET BOTH EXPLICITLY.
# Leave blank until you generate real values; a blank value becomes random
# (fail-closed) and makes login impossible until you set it.
CONSOLE_TOKEN=
# Session-cookie signing secret. It is never derived from the token.
CONSOLE_SECRET=
# 1 when Pangolin terminates HTTPS (adds Secure to the session cookie).
CONSOLE_SECURE_COOKIE=1
# Absolute session lifetime in seconds (12 h); no sliding refresh.
CONSOLE_SESSION_TTL=43200
# Failed auth attempts per minute per source IP before a 429.  Note: behind
# Pangolin the console sees the proxy's address unless forwarded headers are
# enabled, so this behaves as a stricter shared limit.
CONSOLE_LOGIN_RATE=5

# --- network ----------------------------------------------------------------
# Host-networked container; bind the tunnel address only. Do not use 0.0.0.0:
# the healthcheck curls this exact address.
CONSOLE_BIND=100.64.0.9
CONSOLE_PORT=8080

# --- paths (container paths; compose.yml pins these) -----------------------
CONSOLE_DB_PATH=/data/edge.sqlite
CONSOLE_SIDECAR_DIR=/var/lib/console
CONSOLE_RPC_SOCK=/run/kamailio/kamailio_rpc.sock
# Per-RPC timeout in milliseconds; a timeout surfaces as an unreachable edge,
# never a process crash.
CONSOLE_RPC_TIMEOUT_MS=2000

# --- behaviour --------------------------------------------------------------
# Per-table reload throttle map (plan §10). RESERVED: the current code takes
# throttle_seconds from console/tables.yaml (5 s per table), and settings.py
# does not read this variable yet. Setting it has no effect today.
# Expected keys when wired: tenant_registry, landline, dispatcher, dialplan,
# trusted (the descriptor table names).
#CONSOLE_THROTTLE_TENANTDOM=5
# Comma-separated suffixes accepted for a home domain.  Keep this in sync with
# TENANTSUFFIXRE in kamailio/kamailio.cfg; the edge rejects domains outside it
# before the mtree lookup.
CONSOLE_ALLOWED_SUFFIXES=home.example.net
# Live-dashboard polling interval in ms. Use ~500 in the lab.
CONSOLE_POLL_MS=15000
# 1 = every mutating route is gated, action buttons are disabled and the
# read-only banner is shown. The first production session MUST start at 1.
CONSOLE_READONLY=1
# 1 = the wizard shows the mandatory TLS-SAN notice (ACME_DOMAINS + one-shot
# force reissue) because the wildcard does not cover two-label home domains.
CONSOLE_TLS_LIVE=1

# --- OIDC sign-in (docs/oidc.md) -----------------------------------------
# both = SSO + break-glass token (default), oidc = SSO only, token = legacy only
CONSOLE_AUTH_MODE=both
#OIDC_ISSUER=https://id.example.net
#OIDC_CLIENT_ID=voip-edge-console
#OIDC_CLIENT_SECRET=          # docker secret / stack env only, never commit
#OIDC_SCOPES=openid profile email groups
#OIDC_REDIRECT_URI=https://console.example.net/auth/callback
#OIDC_POST_LOGOUT_URI=https://console.example.net/login
#OIDC_ALLOWED_GROUPS=edge-operators
#OIDC_ALLOWED_EMAIL_DOMAINS=example.net
#OIDC_PROVIDER_NAME=Example ID
# Explicitly allow any authenticated subject when no group/domain allowlist is
# configured.  Fail-closed by default: without this or an allowlist, SSO login
# is denied.
#OIDC_ALLOW_ANY=1
# Allow http:// issuer/endpoints for loopback development only.  Never set
# this on a public deployment.
#OIDC_INSECURE=1

# Lifecycle/pending-reload sweeper cadence in seconds (0 disables).  Tests set
# 0; production keeps the default.
#CONSOLE_SWEEPER_INTERVAL=30
# Refuse park/destroy when the edge proves htable.delete is missing. This
# example enables the production-safe gate; tests override it to 0 where a
# fault-injecting RPC double is used.
CONSOLE_ENFORCE_CAPABILITIES=1
