# env for the stack "voip-edge" (Arcane: paste into the stack env editor;
# plain compose: copy to .env next to docker-compose.yml).
#
# ONE workspace root holds all edge data (config, db, tls, acme.sh, rtpe conf):
EDGE_HOME=/opt/voip-edge
EDGE_RUN=/run/kamailio-edge

# upstream rtpengine release tag for the ONE image build (only used at
# `docker compose build` time; Arcane builds once via the Images UI):
#RTPE_VERSION=mr26.3.1.2

# kamailio memory pools (MB): shm = transactions/caches, pkg = per-worker heap.
# 256/64 is comfortable for this workload; verify with kamcmd shm/pkg.stats
#SHM_MEMORY=256
#PKG_MEMORY=64

# --- acme.sh / LetsEncrypt wildcard (DEPLOY.md §B) ---
ACME_EMAIL=admin@example.net
# defaults are set in compose; override to deviate. Phone-facing TLS uses
# PER-TENANT SANs (LE wildcards cover one label only, so *.home.example.net
# does NOT match sip.<client>.home.example.net). ACME_CERT_NAME must always
# be the FIRST entry of ACME_DOMAINS:
#ACME_DOMAINS=sip.alpha.home.example.net,*.home.example.net
#ACME_CERT_NAME=sip.alpha.home.example.net
# add a tenant = append its sip.<c>... SAN to ACME_DOMAINS + one-shot
# ACME_FORCE_ISSUE=1 & restart voip-acme (README §Onboarding step 4)
#ACME_SERVER=letsencrypt          # or letsencrypt_test while debugging
#ACME_KEYLENGTH=2048
#ACME_DNSSLEEP=60
#ACME_DNS_PROVIDER=dns_nsupdate   # or dns_technitium (REST API)
#ACME_FORCE_ISSUE=0

# Technitium DNS (RFC2136 nsupdate target):
NSUPDATE_SERVER=192.0.2.53        # Technitium host reachable from the VPS
#NSUPDATE_SERVER_PORT=53
#NSUPDATE_ZONE=home.example.net
# the TSIG key itself is a FILE at $EDGE_HOME/acme/technitium_tsig (docker
# secret). Only for ACME_DNS_PROVIDER=dns_technitium:
#Technitium_Server=
#Technitium_Token=
